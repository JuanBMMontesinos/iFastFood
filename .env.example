# ---- iFastFood — variáveis de ambiente (F0) ---------------------------------
# Copie para .env e preencha os valores reais. NUNCA comite o .env real.

# Node / app
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Database (docker-compose local)
DATABASE_URL=postgresql://ifastfood:ifastfood_dev@localhost:5432/ifastfood?schema=public

# Redis (filas/cache/geo)
REDIS_URL=redis://localhost:6379

# Meilisearch (fase de busca)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# Autenticação (preencher com segredos fortes em produção — usar vault)
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Gateways de pagamento (adapters configurados nas fases F3+)
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapas / geolocalização
GOOGLE_MAPS_API_KEY=

# Comunicação
FCM_SERVER_KEY=
RESEND_API_KEY=
SMS_PROVIDER_API_KEY=
