# ---- iFastFood — variáveis de ambiente (F0) ---------------------------------
# Copie para .env e preencha os valores reais. NUNCA comite o .env real.

# Node / app
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Database — Supabase (conexão direta, IPv6). Para runtime em produção,
# gere a string do Connection Pooler (Supavisor, porta 5432 session mode):
#   DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-REGIAO.pooler.supabase.com:5432/postgres
#   DATABASE_URL_DIRECT=postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://ifastfood:ifastfood_dev@localhost:5432/ifastfood?schema=public

# Redis (filas/cache/geo) — host 6380 no compose local
REDIS_URL=redis://localhost:6380

# Meilisearch (fase de busca)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# Autenticação (preencher com segredos fortes em produção — usar vault)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=

# Gateways de pagamento (adapters configurados nas fases F3+)
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapas / geolocalização
GOOGLE_MAPS_API_KEY=

# Comunicação
FCM_SERVER_KEY=
RESEND_API_KEY=
SMS_PROVIDER_API_KEY=

# Pepper do hash de códigos OTP (rotativo; NUNCA logar nem comitar)
OTP_PEPPER=

# Criptografia de campo para PII/segredos em repouso (AES-256-GCM, 32 bytes hex)
IDENTITY_FIELD_KEY=

# Seed RBAC (pnpm --filter @ifastfood/api db:seed): admin inicial do backoffice
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
