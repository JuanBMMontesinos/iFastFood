{
  "name": "ifastfood",
  "version": "0.1.0",
  "private": true,
  "description": "iFastFood — plataforma marketplace de delivery de comida/mercado (cliente, parceiro, entregador, backoffice).",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@ifastfood/api",
    "dev:admin": "turbo run dev --filter=@ifastfood/admin",
    "dev:landing": "turbo run dev --filter=@ifastfood/web-landing",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
